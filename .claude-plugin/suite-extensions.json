{
  "$schema": "../schemas/suite-extensions.schema.json",
  "schema_version": "1.0",
  "suite": {
    "name": "claude-deep-suite",
    "harness_taxonomy": "boeckeler-2026",
    "telemetry_namespace": "suite",
    "x-model-routing": {
      "decision_plane": "deep-model-router",
      "request": "RouteRequestV1",
      "decision": "RouteDecisionV1"
    }
  },
  "plugins": {
    "deep-work": {
      "runtime": ["node", "bash"],
      "capabilities": ["planning", "phase-guard", "tdd", "receipts", "quality-gates", "topology-templates"],
      "artifacts": {
        "writes": [
          ".deep-work/<session>/session-receipt.json",
          ".deep-work/<session>/receipts/SLICE-*.json",
          ".deep-work/harness-history/harness-sessions.jsonl"
        ],
        "reads": [
          ".deep-dashboard/harnessability-report.json",
          ".deep-evolve/<session>/evolve-insights.json",
          ".deep-review/recurring-findings.json",
          "<wiki_root>/.wiki-meta/index.json"
        ]
      },
      "hooks_active": ["SessionStart", "PreToolUse", "PostToolUse", "Stop"]
    },
    "deep-wiki": {
      "runtime": ["bash", "node"],
      "capabilities": ["persistent-memory", "auto-ingest", "trust-boundary-closure", "agent-tool-lint"],
      "artifacts": {
        "writes": [
          "<wiki_root>/log.jsonl",
          "<wiki_root>/.wiki-meta/index.json",
          "<wiki_root>/.wiki-meta/.versions/*",
          "<wiki_root>/pages/**/*.md"
        ],
        "reads": [
          "<wiki_root>/.wiki-meta/.pending-scan"
        ]
      },
      "hooks_active": ["SessionStart"]
    },
    "deep-evolve": {
      "runtime": ["python", "bash"],
      "capabilities": ["autonomous-experiment", "n-seed-parallel", "outer-inner-loop", "immutable-guard"],
      "artifacts": {
        "writes": [
          ".deep-evolve/current.json",
          ".deep-evolve/<session>/evolve-receipt.json",
          ".deep-evolve/<session>/evolve-insights.json",
          ".deep-evolve/<session>/forum.jsonl"
        ],
        "reads": [
          ".deep-review/recurring-findings.json"
        ]
      },
      "hooks_active": ["PreToolUse"]
    },
    "deep-review": {
      "runtime": ["bash", "node"],
      "capabilities": ["independent-evaluation", "cross-model-verification", "fitness-validation", "phase-6-delegation"],
      "artifacts": {
        "writes": [
          ".deep-review/reports/<timestamp>-review.md",
          ".deep-review/responses/<timestamp>-response.md",
          ".deep-review/recurring-findings.json",
          ".deep-review/entropy-log.jsonl"
        ],
        "reads": [
          ".deep-work/<session>/session-receipt.json",
          ".deep-review/contracts/SLICE-*.yaml",
          ".deep-review/fitness.json"
        ]
      },
      "hooks_active": [],
      "hooks_intentionally_empty_reason": "Evaluator는 user-invocation 기반 trust-boundary 설계 — event-driven hooks를 두지 않아 자기 결과를 자기 입력으로 삼는 echo chamber를 차단."
    },
    "deep-docs": {
      "runtime": ["node"],
      "capabilities": ["doc-gardening", "scan-garden-audit", "schema-versioned-artifact"],
      "artifacts": {
        "writes": [
          ".deep-docs/last-scan.json"
        ],
        "reads": []
      },
      "hooks_active": [],
      "hooks_intentionally_empty_reason": "Garden은 user 명시 호출(scan/garden/audit)로만 trigger — 자동 hook은 doc rot 방지 직관과 무관하게 noise를 만든다."
    },
    "deep-dashboard": {
      "runtime": ["node"],
      "capabilities": ["harnessability-scoring", "cross-plugin-aggregation", "effectiveness-scoring"],
      "artifacts": {
        "writes": [
          ".deep-dashboard/harnessability-report.json"
        ],
        "reads": [
          ".deep-work/**",
          ".deep-review/**",
          ".deep-docs/**",
          ".deep-evolve/**",
          "<wiki_root>/.wiki-meta/**"
        ]
      },
      "hooks_active": [],
      "hooks_intentionally_empty_reason": "Aggregator는 user 명시 호출(/deep-harness-dashboard)에서만 보고서를 생성 — event-driven hook은 cross-plugin 집계 의미와 무관하게 noise를 만든다."
    },
    "deep-memory": {
      "runtime": ["node", "bash"],
      "capabilities": [
        "cross-project-semantic-memory",
        "cross-runtime-hook-capture",
        "hybrid-distill",
        "fts5-lexical-retrieval",
        "vector-retrieval",
        "rrf-fusion",
        "mcp-server-stdio",
        "gate2-slash-only-mutation",
        "audit-log-envelope",
        "multi-pass-redaction",
        "project-lease",
        "atomic-write",
        "envelope-compat-option-b"
      ],
      "artifacts": {
        "writes": [
          "~/.deep-memory/events/<YYYY-MM>.jsonl",
          "~/.deep-memory/audit-log/<YYYY-MM>.jsonl",
          "~/.deep-memory/cards/<memory_type>/<global|project_id>/<memory_id>.json",
          "~/.deep-memory/indexes/lexical.sqlite",
          "~/.deep-memory/indexes/vector.sqlite",
          "~/.deep-memory/projects/<project_id>.json",
          "~/.deep-memory/.last-distill-cursor/<project_id>",
          "~/.deep-memory/.dedupe-window/<project_id>.jsonl",
          "~/.deep-memory/.embed-model-version",
          "~/.deep-memory/.leases/<project_id>.lease",
          "~/.deep-memory/.lock/metadata.json",
          "~/.deep-memory/.quarantine/empty-claim/<run_id>.json",
          ".deep-memory/project-profile.json",
          ".deep-memory/latest-harvest.json",
          ".deep-memory/latest-brief.{json,md}",
          ".deep-memory/latest-audit.json"
        ],
        "reads": [
          ".deep-review/recurring-findings.json",
          ".deep-evolve/<session>/evolve-insights.json",
          ".deep-work/<session>/session-receipt.json",
          ".deep-docs/last-scan.json",
          "<wiki_root>/.wiki-meta/index.json"
        ]
      },
      "hooks_active": [
        "SessionStart",
        "UserPromptSubmit",
        "PostToolUse",
        "PostToolUseFailure",
        "PreCompact",
        "SessionEnd"
      ],
      "x-hooks-active-reason": "v1.0.5 agentmemory-style hook capture — Tier-1 hooks ingest host events into ~/.deep-memory/events/. Each hook gates on config.capture.enabled BEFORE stdin read (R4-D privacy invariant); capture default OFF on non-interactive init. Claude registers the 6-hook Tier-1 set; Codex registers its 4-hook subset (SessionStart, UserPromptSubmit, PostToolUse, PreCompact). Both manifests use plugin-local self-contained bootstraps and per-host root detection.",
      "x-mcp-server": {
        "transport": "stdio",
        "auto_spawn": true,
        "config_path": ".mcp.json",
        "tools": 10,
        "resources": 5,
        "prompts": 2,
        "mutation_gate": "spec §6.3.1 Gate 2/3 — forget + audit(mode!=check) + export(scope=all) return slash_only_in_v030"
      }
    },
    "deep-goal": {
      "runtime": ["node"],
      "capabilities": ["goal-compilation", "prerequisite-scouting", "goal-reshaping", "synergy-recipes", "release-lint"],
      "artifacts": {
        "writes": [],
        "reads": []
      },
      "hooks_active": [],
      "hooks_intentionally_empty_reason": "Goal compiler는 user 명시 호출(/deep-goal) 기반 — event-driven hooks는 goal condition 컴파일 워크플로와 무관하게 noise를 만든다."
    },
    "deep-loop": {
      "runtime": ["node"],
      "capabilities": ["orchestration", "loop-state", "durable-state", "checkpoint", "handoff", "respawn", "cross-plugin-routing", "budget-breaker-gates", "project-root-recovery"],
      "artifacts": {
        "writes": [
          ".deep-loop/runs/<run-id>/loop.json",
          ".deep-loop/runs/<run-id>/event-log.jsonl",
          ".deep-loop/runs/<run-id>/handoffs/<ts>-next-session.md",
          ".deep-loop/runs/<run-id>/checkpoints/<checkpoint-key>-compact.json",
          ".deep-loop/runs/<run-id>/checkpoints/<checkpoint-key>-compact-observation.json",
          ".deep-loop/runs/<run-id>/checkpoints/<checkpoint-key>-compact-prune.json",
          ".deep-loop/runs/<run-id>/compact-restore-intents/<operation-id>.prepared.json",
          ".deep-loop/runs/<run-id>/transactions/<operation-id>/prepared.json",
          ".deep-loop/runs/<run-id>/transactions/<operation-id>/committed.json",
          ".deep-loop/runs/<run-id>/recoveries/<child-run-id>-affinity-recovery.json",
          ".deep-loop/runs/<run-id>/recoveries/<child-run-id>-boundary-recovery.json",
          ".deep-loop/runs/<run-id>/recoveries/root/<replacement-session-id>.json",
          ".deep-loop/runs/<run-id>/recoveries/root-operations/<operation-id>.json",
          ".deep-loop/runs/<run-id>/terminal/launch-command.txt",
          ".deep-loop/runs/<run-id>/terminal/launch-command.meta.json",
          ".deep-loop/runs/<run-id>/reviews/<sha256>.json",
          ".deep-loop/runs/<run-id>/preflight/cache/<cache-key>.json",
          ".deep-loop/runs/<run-id>/preflight/accounting/<cache-key>.json",
          ".deep-loop/runs/<run-id>/preflight/process-receipts/<receipt>.json",
          ".deep-loop/runs/<run-id>/final-report.md",
          ".deep-loop/current"
        ],
        "reads": [
          ".deep-work/<session>/session-receipt.json",
          ".deep-review/reports/*.md",
          ".deep-docs/last-scan.json",
          ".deep-evolve/evolve-receipt.json",
          ".deep-dashboard/harnessability-report.json"
        ]
      },
      "hooks_active": ["PreCompact", "PostCompact", "SessionStart"],
      "x-session-start-sources": ["compact"]
    },
    "deep-model-router": {
      "runtime": ["python"],
      "capabilities": ["model-routing", "review-policy", "effort-map", "dispatch-receipt"],
      "artifacts": {
        "writes": [],
        "reads": []
      },
      "hooks_active": ["SessionStart"],
      "x-model-routing": {
        "decision_plane": "deep-model-router",
        "request": "RouteRequestV1",
        "decision": "RouteDecisionV1"
      }
    }
  },
  "data_flow": [
    { "from": "deep-work", "to": "deep-review", "via": "session-receipt" },
    { "from": "deep-work", "to": "deep-dashboard", "via": "session-receipt + harness-sessions.jsonl" },
    { "from": "deep-docs", "to": "deep-dashboard", "via": "last-scan.json" },
    { "from": "deep-evolve", "to": "deep-dashboard", "via": "evolve-receipt" },
    { "from": "deep-evolve", "to": "deep-work", "via": "evolve-insights (Research context)" },
    { "from": "deep-dashboard", "to": "deep-work", "via": "harnessability-report.json (Phase 1 Research consumes)" },
    { "from": "deep-review", "to": "deep-evolve", "via": "recurring-findings.json" },
    { "from": "deep-wiki", "to": "deep-work", "via": "index.json (Research reference)" },
    { "from": "deep-review", "to": "deep-memory", "via": "recurring-findings.json (harvest source)" },
    { "from": "deep-evolve", "to": "deep-memory", "via": "evolve-insights.json (harvest source)" },
    { "from": "deep-work", "to": "deep-memory", "via": "session-receipt.json (harvest source)" },
    { "from": "deep-docs", "to": "deep-memory", "via": "last-scan.json (harvest source)" },
    { "from": "deep-wiki", "to": "deep-memory", "via": "index.json (harvest source — intent only; the payload contract does not currently align)" },
    { "from": "deep-memory", "to": "deep-work", "via": "latest-brief.md (Phase 1 Research recall — sibling consumers quote in research/planning prompts)" }
  ]
}
